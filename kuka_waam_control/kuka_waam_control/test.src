DEF TEST()
;FOLD INI
  ;FOLD BASISTECH INI
    BAS (#INITMOV,0)
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;WAAM-optimized initialization
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

BASE_DATA[8] = {FRAME: X 168.4, Y -507.55, Z 688.59, A 179.6, B -1.15, C 0.29}
TOOL_DATA[4] = {FRAME: X -17.74, Y -37.22, Z 294.62, A 0, B 0, C 0}
$BASE = BASE_DATA[8]
$TOOL = TOOL_DATA[4]

BAS (#VEL_PTP,100)
BAS (#ACC_PTP,100)
BAS (#VEL_CP,0.0100)
BAS (#ACC_CP,0.05)

$VEL.CP = 0.0100
$ACC.CP = 0.05
$VEL.ORI1 = 90
$VEL.ORI2 = 90
$ACC.ORI1 = 500
$ACC.ORI2 = 500
$ORI_TYPE = #VAR
$ADVANCE = 1
$APO.CDIS = 2.00

PTP HOME
CONTINUE
$OUT[1] = FALSE
WAIT SEC 0.5

;===========
; BEGIN WAAM PROCESS
; Speed: 5mm/s weld, 10mm/s travel
; Arc length: 2mm TCP offset
; Dynamic torch orientation
;===========

PTP {X 0.000, Y 0.000, Z 50.000, A 129.7, B -46.5, C 162.4}
PTP {X 0.000, Y 0.000, Z 10.000, A 129.7, B -46.5, C 162.4}
LIN {X 100.000, Y 0.000, Z 5.000, A 129.7, B -46.5, C 162.4}
LIN {X 100.000, Y 100.000, Z 5.000, A 129.7, B -46.5, C 162.4}
LIN {X 0.000, Y 100.000, Z 5.000, A 129.7, B -46.5, C 162.4}
LIN {X 0.000, Y 0.000, Z 5.000, A 129.7, B -46.5, C 162.4}
PTP {X 0.000, Y 0.000, Z 50.000, A 129.7, B -46.5, C 162.4}

;===========
; WAAM PROCESS COMPLETE
;===========

$VEL.CP = 0.0100
LIN_REL {Z 20}
WAIT SEC 0
PTP HOME

END
